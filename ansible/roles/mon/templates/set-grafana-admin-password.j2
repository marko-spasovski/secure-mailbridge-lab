#!/bin/bash
# {{ ansible_managed }}
# Decision 112, the pattern of decisions 52 and 94.
# Usage: set-grafana-admin-password [check]
# Tests a login as admin with the password from SSM (already written to
# /etc/grafana/admin-password by fetch-ssm-param) and resets it through
# Grafana's CLI only if the login fails. Prints "changed" or "unchanged",
# never the value. With "check", reports what would change and writes nothing.
set -euo pipefail
check=${1:-}
pw=$(cat /etc/grafana/admin-password)
[ -n "$pw" ] || { echo "empty admin password" >&2; exit 1; }

# The credentials go to curl on stdin (-K -), never on its command line,
# where ps would show them. -k: this is the host talking to its own
# listener; the certificate is checked from the admin pool instead.
code=$(printf 'user = "admin:%s"\n' "$pw" | curl -s -k -K - -o /dev/null \
  -w '%{http_code}' https://{{ mon_private_ip }}:3000/api/user)

case "$code" in
  200)
    echo unchanged
    ;;
  401)
    if [ "$check" != check ]; then
      printf '%s' "$pw" | runuser -u grafana -- grafana cli \
        --homepath /usr/share/grafana --config /etc/grafana/grafana.ini \
        admin reset-admin-password --password-from-stdin >/dev/null
    fi
    echo changed
    ;;
  *)
    echo "unexpected HTTP $code from Grafana" >&2
    exit 1
    ;;
esac
