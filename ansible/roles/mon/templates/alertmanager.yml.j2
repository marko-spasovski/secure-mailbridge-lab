# {{ ansible_managed }}
# Alertmanager on mon (task 1.23, decisions 110, 126). Every alert goes to
# Discord. The webhook URL is a bearer secret, so it's read from a file
# pulled from SSM, never written into this config.
route:
  receiver: discord
  group_by: [alertname, host, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: discord
    discord_configs:
      - webhook_url_file: {{ mon_discord_webhook_file }}
        send_resolved: true
