# {{ ansible_managed }}
# Prometheus on mon (tasks 1.22, 1.23): its own exporters, every host's, and
# the lab's alert rules (decision 126).
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["{{ mon_alertmanager_listen }}"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ mon_prometheus_listen }}"]

  - job_name: alertmanager
    static_configs:
      - targets: ["{{ mon_alertmanager_listen }}"]

  - job_name: node
    static_configs:
{% for t in mon_node_targets + (mon_vuln_node_targets if groups['vuln'] | default([]) | length > 0 else []) %}
      - targets: ["{{ t.address }}"]
        labels:
          host: {{ t.host }}
{% endfor %}

  - job_name: postgres
    static_configs:
      - targets: ["{{ mon_postgres_target }}"]
        labels:
          host: db

  # Probes through blackbox_exporter on loopback (decision 125): the target
  # becomes a parameter, and the instance label keeps the probed address.
  - job_name: blackbox
    scrape_interval: 30s
    metrics_path: /probe
    static_configs:
      - targets: ["https://{{ mon_proxy_ip }}/healthz"]
        labels:
          module: https_mail
      - targets: ["{{ mon_unbound_ip }}"]
        labels:
          module: dns_mail
    relabel_configs:
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ mon_blackbox_listen }}"

  # CPU credit balances from CloudWatch through YACE (decision 121). The
  # account ID (account_id, the ARN in name) and the instance ID are dropped,
  # so neither can reach a screenshot or a report; host matches
  # node_exporter's label.
  - job_name: yace
    scrape_interval: 60s
    static_configs:
      - targets: ["{{ mon_yace_listen }}"]
    metric_relabel_configs:
      - source_labels: [tag_Name]
        regex: mailbridge-lab-(.+)
        target_label: host
      - regex: account_id|name|dimension_InstanceId
        action: labeldrop
