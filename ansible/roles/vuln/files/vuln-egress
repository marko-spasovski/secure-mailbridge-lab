#!/bin/sh
# Managed by Ansible (vuln role). Decision 69: the container may answer the
# connections proxy opens to it, and may open none of its own, anywhere.
# DOCKER-USER sees traffic the container sends through the host (FORWARD);
# INPUT gets the same pair for traffic to the host itself (node_exporter,
# the bridge address). Each rule is checked first, so reruns add nothing.
set -eu
ipt=/usr/sbin/iptables
ensure() { # chain, then the rule
  chain=$1; shift
  $ipt -C "$chain" "$@" 2>/dev/null || $ipt -A "$chain" "$@"
}
$ipt -N DOCKER-USER 2>/dev/null || true
$ipt -N VULN-CONTAINER-IN 2>/dev/null || true
for chain in DOCKER-USER VULN-CONTAINER-IN; do
  ensure "$chain" -i docker0 -m conntrack --ctstate NEW \
    -m limit --limit 10/second --limit-burst 20 \
    -j LOG --log-prefix "VULN-EGRESS-DROP "
  ensure "$chain" -i docker0 -m conntrack --ctstate NEW -j DROP
done
# DOCKER-USER ends with Docker's own RETURN; ours must come before it.
if $ipt -S DOCKER-USER | head -2 | tail -1 | grep -q -- '-j RETURN'; then
  $ipt -D DOCKER-USER -j RETURN
  $ipt -A DOCKER-USER -j RETURN
fi
$ipt -C INPUT -j VULN-CONTAINER-IN 2>/dev/null || $ipt -I INPUT 1 -j VULN-CONTAINER-IN
