# {{ ansible_managed }}
# Local rules that run before the CRS (its REQUEST-900 slot). IDs 10000 to
# 10999 are ours; the CRS keeps 1 to 99,999 free for local rules.

# --- Profile photo (PUT /users/me/avatar) ------------------------------------
# The photo is ~800 KB of base64 in a data URL, and random base64 trips CRS
# attack rules by chance (932235, 934170, 941130 and others in testing).
# Instead of turning rules off, the WAF enforces the exact shape the app
# accepts (Mailbridge src/modules/users/avatar.ts) and then skips the attack
# rules for that one field on that one route. Base64 can't carry an
# injection; the app checks the decoded bytes. Every other field and route
# is inspected as before.

# 1. Anything else in that field is refused. ++ is possessive, so a
#    mismatch fails without backtracking and stays under SecPcreMatchLimit.
SecRule REQUEST_METHOD "@streq PUT" \
    "id:10010,\
    phase:2,\
    deny,\
    status:400,\
    log,\
    msg:'Profile photo is not a base64 PNG, JPEG or WebP data URL',\
    tag:'local/avatar',\
    chain"
    SecRule REQUEST_FILENAME "@streq /users/me/avatar" "chain"
        SecRule ARGS:json.image "!@rx ^data:image/(?:png|jpeg|webp);base64,[A-Za-z0-9+/]++={0,2}$" \
            "t:none"

# 2. The attack rules skip that field there. ctl sits in the last rule of
#    the chain, so it runs only when both conditions match.
SecRule REQUEST_METHOD "@streq PUT" \
    "id:10011,\
    phase:1,\
    pass,\
    nolog,\
    tag:'local/avatar',\
    chain"
    SecRule REQUEST_FILENAME "@streq /users/me/avatar" \
        "t:none,\
        ctl:ruleRemoveTargetByTag=attack-rce;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-xss;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-sqli;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-ssrf;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-generic;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-injection-php;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-lfi;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-rfi;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-injection-generic;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-injection-java;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-ssti;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-fixation;ARGS:json.image,\
        ctl:ruleRemoveTargetByTag=attack-protocol;ARGS:json.image"

# --- Juice Shop's socket.io long-polling (decision 139) ----------------------
# The Juice Shop web app opens a socket.io connection on every page (its live
# challenge notifications). socket.io starts with HTTP long-polling and sends
# its packets as POST /socket.io/?EIO=4&transport=polling with Content-Type
# text/plain, which the CRS default list doesn't allow: 920420 scores 5 and
# 949110 answers 403, so the connection never opens. Only 920420 is removed,
# and only when all five conditions match; mail, every other route and every
# other content type stay as strict as before. A text/plain body isn't parsed
# into ARGS, so rules that read only ARGS don't see these payloads: accepted,
# because they carry only notifications.
SecRule REQUEST_HEADERS:Host "@streq vuln.{{ domain }}" \
    "id:10020,\
    phase:1,\
    pass,\
    nolog,\
    t:none,t:lowercase,\
    tag:'local/socketio',\
    chain"
    SecRule REQUEST_METHOD "@streq POST" "chain"
        SecRule REQUEST_FILENAME "@streq /socket.io/" "chain"
            SecRule ARGS_GET:transport "@streq polling" "chain"
                SecRule REQUEST_HEADERS:Content-Type "@rx ^text/plain(?:;\s*charset=utf-8)?$" \
                    "t:none,t:lowercase,\
                    ctl:ruleRemoveById=920420"

# --- Gmail OAuth callback scope (decision 146) --------------------------------
# Google returns the granted scopes on the callback, and one of them is
# https://www.googleapis.com/auth/userinfo.profile: "userinfo.profile" holds
# ".profile", which CRS 930120 (OS file access) lists as a Unix dotfile, so
# every Gmail connect got 403. Only 930120, only on the scope argument, only on
# this route of mail.<domain>; every other rule still reads scope, and 930120
# still reads every other argument and route. Mailbridge only compares scope
# with the scopes it asked for and never uses it as a path.
SecRule REQUEST_HEADERS:Host "@streq mail.{{ domain }}" \
    "id:10030,\
    phase:1,\
    pass,\
    nolog,\
    t:none,t:lowercase,\
    tag:'local/oauth-callback',\
    chain"
    SecRule REQUEST_METHOD "@streq GET" "chain"
        SecRule REQUEST_FILENAME "@streq /accounts/callback/gmail" \
            "t:none,\
            ctl:ruleRemoveTargetById=930120;ARGS:scope"
