# {{ ansible_managed }}
# Loaded by the mail site. Order matters: engine, CRS settings, our
# exclusions (they must run before the rules they change), then the rules
# with their plugin hooks, as the CRS's INSTALL.md lists them.
Include /etc/nginx/modsec/modsecurity.conf
Include /etc/nginx/modsec/crs-setup.conf
Include /etc/nginx/modsec/exclusions-before.conf
Include {{ proxy_crs_dir }}/plugins/*-config.conf
Include {{ proxy_crs_dir }}/plugins/*-before.conf
Include {{ proxy_crs_dir }}/rules/*.conf
Include {{ proxy_crs_dir }}/plugins/*-after.conf
