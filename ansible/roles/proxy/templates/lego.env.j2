# {{ ansible_managed }}
# lego's settings for {{ item }}.{{ domain }} (decisions 59, 60, 70), read by
# lego-renew@{{ item }}.service.
LEGO_SERVER={{ proxy_acme_server }}
LEGO_ACCEPT_TOS=true
LEGO_ACCOUNT_ID=mailbridge-lab
LEGO_DOMAINS={{ item }}.{{ domain }}
LEGO_KEY_TYPE=EC256
LEGO_PATH=/var/lib/lego
LEGO_LOG_FORMAT=text
LEGO_DNS=route53
# proxy may send DNS only to AmazonProvidedDNS and Unbound, not to the
# zone's authoritative servers on the internet, so lego checks propagation
# through the resolver only. The Route 53 provider already waits for the
# change to be INSYNC with GetChange.
LEGO_DNS_PROPAGATION_DISABLE_ANS=true
# Runs as lego only after a new or renewed certificate; the root step in
# the service reloads Nginx when it finds this file.
LEGO_DEPLOY_HOOK=/usr/bin/touch /var/lib/lego/renewed-{{ item }}
AWS_REGION=eu-central-1
AWS_HOSTED_ZONE_ID={{ proxy_zone_id }}
