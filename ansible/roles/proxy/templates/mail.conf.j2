# {{ ansible_managed }}
# mail.<domain> on proxy (decision 61, Mailbridge docs/deployment.md §3).

# Rate limits (decisions 77, 78), keyed by the client's address: VPN pools
# aren't NATed, so this is the device. Requests over the limit get 429 and
# never reach the app or its database (ModSecurity's header rules run
# earlier, in the rewrite phase). The auth key is empty for anything but
# POST, and an empty key isn't counted.
limit_req_zone $binary_remote_addr zone=mail_general:10m rate={{ proxy_limit_general_rate }};
map $request_method $mail_auth_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $mail_auth_key zone=mail_auth:10m rate={{ proxy_limit_auth_rate }};

# A client that asks for any other name, or none, gets no certificate and no
# site. ssl_protocols is repeated in each server: Nginx picks the protocol
# from the default server before it knows the requested name.
server {
    listen {{ proxy_private_ip }}:443 ssl http2 default_server;
    ssl_reject_handshake on;
    ssl_protocols TLSv1.3;
    server_tokens off;
}

server {
    listen {{ proxy_private_ip }}:443 ssl http2;
    server_name mail.{{ domain }};

    ssl_certificate     /var/lib/lego/certificates/mail.{{ domain }}.crt;
    ssl_certificate_key /var/lib/lego/certificates/mail.{{ domain }}.key;

    # TLS 1.3 only (Mozilla "modern"); its ciphers need no list.
    ssl_protocols TLSv1.3;
    ssl_session_cache shared:mail_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # One access log per site (decision 137), in the default combined format
    # that Wazuh's web decoders parse; the file name tells mail from vuln.
    access_log /var/log/nginx/mail.access.log;

    server_tokens off;
    # Nginx alone sets HSTS (decision 62). The app sends its own one-year
    # header, and browsers obey only the first of two, so it is dropped here.
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age={{ proxy_hsts_max_age }}" always;

    # The app accepts bodies up to 800 KB.
    client_max_body_size 1m;

    # ModSecurity with the CRS (decisions 58, 63 to 66). Only here: the
    # default server refuses the handshake, so it never sees HTTP.
    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/main.conf;

    # Logged at error: Ubuntu's error_log keeps error and above, so warn
    # entries would never reach the file or Wazuh.
    limit_req_status 429;
    limit_req_log_level error;

    location / {
        limit_req zone=mail_general burst={{ proxy_limit_general_burst }} nodelay;
        include /etc/nginx/snippets/mail-proxy.conf;
    }

    # Password guessing and mail-flooding paths: both limits apply.
    location ~ ^/auth/(?:login|register|forgot|reset|password)$ {
        limit_req zone=mail_general burst={{ proxy_limit_general_burst }} nodelay;
        limit_req zone=mail_auth burst={{ proxy_limit_auth_burst }} nodelay;
        include /etc/nginx/snippets/mail-proxy.conf;
    }
}
