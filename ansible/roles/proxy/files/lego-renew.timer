# Managed by Ansible (proxy role). Daily check; lego decides whether the
# certificate is due. Persistent catches up a run missed while the host was
# off; the random delay spreads the load on the CA, as Let's Encrypt asks.
[Unit]
Description=Daily lego certificate check

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
