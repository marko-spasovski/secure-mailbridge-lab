# Managed by Ansible (wazuh_agent role, decisions 91, 101). On an agent host
# the Wazuh repository may supply the agent and nothing else: not the
# manager, indexer or dashboard, and never a replacement Ubuntu package.
Package: *
Pin: origin packages.wazuh.com
Pin-Priority: -1

Package: wazuh-agent
Pin: origin packages.wazuh.com
Pin-Priority: 500
