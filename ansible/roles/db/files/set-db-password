#!/bin/sh
# Managed by Ansible (db role). Decisions 47, 52.
# Usage: set-db-password [check]
# Makes the mailbridge role's password match /mailbridge/db-password in SSM,
# pulled with this instance's own role. Prints "changed" or "unchanged",
# never the value. With "check", reports what would change and writes nothing.
#
# The value stays out of argv (visible to every user in ps) and off disk:
# it lives in a shell variable, reaches psql through PGPASSWORD (readable
# only by root and the process owner) and through stdin.
set -eu
param=/mailbridge/db-password
check=${1:-}

pw=$(/snap/bin/aws ssm get-parameter --region eu-central-1 --name "$param" \
  --with-decryption --query Parameter.Value --output text)
[ -n "$pw" ] || { echo "empty or unreadable: $param" >&2; exit 1; }

# Decision 46 makes it letters and digits only, so it is safe inside single
# quotes. Refuse anything else rather than try to escape it.
case $pw in
  *[!A-Za-z0-9]*) echo "unexpected characters in $param" >&2; exit 1 ;;
esac

login_works() {
  PGPASSWORD=$pw PGCONNECT_TIMEOUT=5 psql -X -h 127.0.0.1 -U mailbridge \
    -d mailbridge -tAc 'SELECT 1' >/dev/null 2>&1
}

if login_works; then
  echo unchanged
  exit 0
fi
if [ "$check" = check ]; then
  echo changed
  exit 0
fi

# printf is a shell builtin, so the value never appears in argv. The two SET
# lines stop this session's statement from reaching the server log, even if
# it fails (log_min_error_statement would otherwise log it with the error).
printf "SET log_statement = 'none';\nSET log_min_error_statement = 'panic';\nALTER ROLE mailbridge PASSWORD '%s';\n" "$pw" |
  runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d postgres

login_works || { echo "password set but login still fails" >&2; exit 1; }
echo changed
