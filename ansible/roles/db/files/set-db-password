#!/bin/sh
# Managed by Ansible (db role). Decisions 47, 52, 54.
# Usage: set-db-password <role> <parameter> [check]
# Makes a database role's password match an SSM parameter, pulled with this
# instance's own role. Prints "changed" or "unchanged", never the value.
# With "check", reports what would change and writes nothing.
#
# The value stays out of argv (visible to every user in ps) and off disk:
# it lives in a shell variable, reaches psql through PGPASSWORD (readable
# only by root and the process owner) and through stdin.
set -eu
role=$1 param=$2 check=${3:-}

# The role name goes into SQL, so allow only plain lowercase names.
case $role in
  '' | *[!a-z_]*) echo "invalid role name" >&2; exit 1 ;;
esac

pw=$(/snap/bin/aws ssm get-parameter --region eu-central-1 --name "$param" \
  --with-decryption --query Parameter.Value --output text)
[ -n "$pw" ] || { echo "empty or unreadable: $param" >&2; exit 1; }

# Decisions 46 and 55 make it letters and digits only, so it is safe inside
# single quotes. Refuse anything else rather than try to escape it.
case $pw in
  *[!A-Za-z0-9]*) echo "unexpected characters in $param" >&2; exit 1 ;;
esac

login_works() {
  PGPASSWORD=$pw PGCONNECT_TIMEOUT=5 psql -X -h 127.0.0.1 -U "$role" \
    -d mailbridge -tAc 'SELECT 1' >/dev/null 2>&1
}

if login_works; then
  echo unchanged
  exit 0
fi
if [ "$check" = check ]; then
  echo changed
  exit 0
fi

# printf is a shell builtin, so the value never appears in argv. The two SET
# lines stop this session's statement from reaching the server log, even if
# it fails (log_min_error_statement would otherwise log it with the error).
printf "SET log_statement = 'none';\nSET log_min_error_statement = 'panic';\nALTER ROLE %s PASSWORD '%s';\n" "$role" "$pw" |
  runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d postgres

login_works || { echo "password set but login still fails" >&2; exit 1; }
echo changed
