# Managed by Ansible (siem role, decision 86). The Wazuh repository may
# supply only Wazuh's own packages; anything else it publishes can never be
# installed or replace an Ubuntu package.
Package: *
Pin: origin packages.wazuh.com
Pin-Priority: -1

Package: wazuh-indexer wazuh-manager wazuh-dashboard filebeat
Pin: origin packages.wazuh.com
Pin-Priority: 500
