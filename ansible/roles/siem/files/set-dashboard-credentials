#!/bin/bash
# Managed by Ansible (siem role). Decision 98, the pattern of decision 95.
# Usage: set-dashboard-credentials [check]
# Sets, from SSM:
#   1. the dashboard's keystore: kibanaserver, its user on the indexer
#   2. wazuh.yml: wazuh-wui, its user on the Wazuh API (127.0.0.1:55000)
# Prints "changed" or "unchanged", never a value. With "check", reports what
# would change and writes nothing.
set -euo pipefail
check=${1:-}
changed=no

get() {
  /snap/bin/aws ssm get-parameter --region eu-central-1 --name "$1" \
    --with-decryption --query Parameter.Value --output text
}
kibana_pw=$(get /siem/kibanaserver-password)
wui_pw=$(get /siem/api-wazuh-wui-password)
for v in "$kibana_pw" "$wui_pw"; do
  [ -n "$v" ] || { echo "empty password from SSM" >&2; exit 1; }
done

# 1. The keystore can't be read back; a root-only SHA-256 of what was stored
# says whether it matches SSM (40 random characters: not reversible).
keystore() {
  runuser -u wazuh-dashboard -- /usr/share/wazuh-dashboard/bin/opensearch-dashboards-keystore "$@"
}
mark=/etc/wazuh-dashboard/.keystore-credentials.sha256
want=$(printf 'kibanaserver:%s' "$kibana_pw" | sha256sum | cut -d' ' -f1)
if [ "$(cat "$mark" 2>/dev/null || true)" != "$want" ]; then
  changed=yes
  if [ "$check" != check ]; then
    printf '%s' kibanaserver | keystore add -f --stdin opensearch.username >/dev/null
    printf '%s' "$kibana_pw" | keystore add -f --stdin opensearch.password >/dev/null
    (umask 077; printf '%s\n' "$want" > "$mark")
  fi
fi

# 2. The Wazuh plugin reads the API password from wazuh.yml in plain text
# (its design); the file is the dashboard user's only, 0600. The API's own
# certificate is self-signed by the manager and the plugin doesn't verify
# it, so the API stays on loopback (decision 97).
dir=/usr/share/wazuh-dashboard/data/wazuh/config
conf=$dir/wazuh.yml
# The password is letters, digits and the API's symbols; single quotes in
# YAML take everything literally except a quote, which is doubled.
q=${wui_pw//\'/\'\'}
new=$(cat <<EOF
# Written by set-dashboard-credentials (siem role). Only the default API
# connection; every other plugin setting is the package's default.
hosts:
  - default:
      url: https://127.0.0.1
      port: 55000
      username: wazuh-wui
      password: '$q'
      run_as: false
EOF
)
if ! printf '%s\n' "$new" | cmp -s - "$conf"; then
  changed=yes
  if [ "$check" != check ]; then
    # Each level separately: install -d would create missing parents as
    # root, and the dashboard must create its own subdirectories there.
    install -d -o wazuh-dashboard -g wazuh-dashboard -m 0750 "${dir%/config}" "$dir"
    tmp=$(mktemp "$conf.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$new" > "$tmp"
    chown wazuh-dashboard:wazuh-dashboard "$tmp"
    chmod 0600 "$tmp"
    mv "$tmp" "$conf"
    trap - EXIT
  fi
fi

[ "$changed" = yes ] && echo changed || echo unchanged
