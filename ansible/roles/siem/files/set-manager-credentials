#!/bin/bash
# Managed by Ansible (siem role). Decision 95, the set-db-password pattern.
# Usage: set-manager-credentials [check]
# Sets, from SSM:
#   1. Filebeat's keystore: the indexer admin user and password
#   2. the manager's keystore (indexer connector): the same
#   3. the Wazuh API users wazuh and wazuh-wui
# Prints "changed" or "unchanged", never a value. With "check", reports what
# would change and writes nothing.
#
# Values stay in shell variables and reach each tool on stdin (filebeat
# --stdin, wazuh-keystore's stdin, curl -K - and --data-binary @-), so no
# password is in argv, a log or Ansible output.
set -euo pipefail
check=${1:-}
changed=no

get() {
  /snap/bin/aws ssm get-parameter --region eu-central-1 --name "$1" \
    --with-decryption --query Parameter.Value --output text
}
admin_pw=$(get /siem/indexer-admin-password)
api_pw=$(get /siem/api-wazuh-password)
wui_pw=$(get /siem/api-wazuh-wui-password)
for v in "$admin_pw" "$api_pw" "$wui_pw"; do
  [ -n "$v" ] || { echo "empty password from SSM" >&2; exit 1; }
done

# 1. Filebeat. "test output" logs in to the indexer with the keystore's
# values, so it is the check itself.
fb_keystore=/var/lib/filebeat/filebeat.keystore
if ! filebeat test output >/dev/null 2>&1; then
  changed=yes
  if [ "$check" != check ]; then
    [ -f "$fb_keystore" ] || filebeat keystore create >/dev/null
    printf '%s' admin | filebeat keystore add username --stdin --force >/dev/null
    printf '%s' "$admin_pw" | filebeat keystore add password --stdin --force >/dev/null
    filebeat test output >/dev/null 2>&1 ||
      { echo "filebeat still can't log in to the indexer" >&2; exit 1; }
  fi
fi

# 2. The manager's keystore can't be read back, so a SHA-256 of what was
# stored is kept next to it (root only). The passwords are 40 random letters
# and digits, so the hash can't be reversed.
mark=/var/ossec/etc/.indexer-credentials.sha256
want=$(printf 'admin:%s' "$admin_pw" | sha256sum | cut -d' ' -f1)
if [ "$(cat "$mark" 2>/dev/null || true)" != "$want" ]; then
  changed=yes
  if [ "$check" != check ]; then
    printf '%s' admin | /var/ossec/bin/wazuh-keystore -f indexer -k username
    printf '%s' "$admin_pw" | /var/ossec/bin/wazuh-keystore -f indexer -k password
    umask 077
    printf '%s\n' "$want" > "$mark"
  fi
fi

# 3. The API. A user is right when it logs in with its SSM password;
# otherwise it still has the package default (its own name, as shipped).
api=https://127.0.0.1:55000
login() {  # user password -> token on stdout, or nothing
  printf 'user = "%s:%s"\n' "$1" "$2" |
    curl -sk -K - -X POST "$api/security/user/authenticate?raw=true" -o - -w '\n%{http_code}' |
    awk 'NR==1{t=$0} END{if ($0 == "200") print t}'
}

set_api_user() {  # user new-password
  local user=$1 pw=$2 token id
  [ -n "$(login "$user" "$pw")" ] && return 0
  changed=yes
  [ "$check" = check ] && return 0
  token=$(login "$user" "$user")
  [ -n "$token" ] || { echo "API user $user logs in with neither password" >&2; exit 1; }
  id=$(curl -sk -H @<(printf 'Authorization: Bearer %s' "$token") \
    "$api/security/users?search=$user" |
    python3 -c 'import json, sys
u = sys.argv[1]
print(next(i["id"] for i in json.load(sys.stdin)["data"]["affected_items"] if i["username"] == u))' "$user")
  printf '%s' "$pw" | python3 -c 'import json, sys; print(json.dumps({"password": sys.stdin.read()}))' |
    curl -sk -o /dev/null -w '%{http_code}' -X PUT -H 'Content-Type: application/json' \
      -H @<(printf 'Authorization: Bearer %s' "$token") \
      --data-binary @- "$api/security/users/$id" | grep -qx 200 ||
    { echo "API refused the new password for $user" >&2; exit 1; }
  [ -n "$(login "$user" "$pw")" ] || { echo "API user $user can't log in after the change" >&2; exit 1; }
}
set_api_user wazuh "$api_pw"
set_api_user wazuh-wui "$wui_pw"

[ "$changed" = yes ] && echo changed || echo unchanged
