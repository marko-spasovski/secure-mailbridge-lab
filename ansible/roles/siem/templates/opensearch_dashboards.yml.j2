# Managed by Ansible (siem role, decision 98). The package's file, unchanged
# except: listen on 10.0.5.10 only, TLS 1.3 only (as Nginx and the VPN,
# decision 61), reach the indexer at the address in its certificate, and
# verify that address (full) instead of the chain only.
server.host: {{ siem_private_ip }}
server.port: 443
opensearch.hosts: https://{{ siem_private_ip }}:9200
opensearch.ssl.verificationMode: full
#opensearch.username:
#opensearch.password:
opensearch.requestHeadersAllowlist: ["securitytenant","Authorization"]
opensearch_security.multitenancy.enabled: false
opensearch_security.readonly_mode.roles: ["kibana_read_only"]
server.ssl.enabled: true
server.ssl.supportedProtocols: ["TLSv1.3"]
server.ssl.key: "/etc/wazuh-dashboard/certs/dashboard-key.pem"
server.ssl.certificate: "/etc/wazuh-dashboard/certs/dashboard.pem"
opensearch.ssl.certificateAuthorities: ["/etc/wazuh-dashboard/certs/root-ca.pem"]
uiSettings.overrides.defaultRoute: /app/wz-home
# Session expiration settings
opensearch_security.cookie.ttl: 900000
opensearch_security.session.ttl: 900000
opensearch_security.session.keepalive: true
