#!/bin/sh
# Managed by Ansible (app role). Decision 54.
# Gives mailbridge_app row access to the tables the migrations just created,
# as the owner. Idempotent: it only adds what is missing.
. /usr/local/lib/mailbridge/common.sh

# PGPASSWORD is readable only by root and this process, never in argv.
PGPASSWORD=$(ssm /mailbridge/db-password)
export PGPASSWORD
exec psql -X -q -h 10.0.4.10 -U mailbridge -d mailbridge \
  -v ON_ERROR_STOP=1 -f /etc/mailbridge/db-roles.sql
