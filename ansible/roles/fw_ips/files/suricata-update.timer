# Managed by Ansible (fw_ips role). Decision 38.
[Unit]
Description=Daily Suricata rule update

[Timer]
OnCalendar=daily
# Don't fetch at the same minute every day.
RandomizedDelaySec=1h
# fw-ips is stopped between sessions: run a missed update at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
